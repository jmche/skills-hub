    "license": "MIT",
    "license_files": ["LICENSE"],
    "rename": { "SKILL.md": "INSTRUCTIONS.md" },
    "exclude": [".gitignore", ".github"],
    "note": "skill package lives in the archify/ subdir of the upstream monorepo; sync to latest stable tag"
  },
  "hyperframes": {
    "repo": "heygen-com/hyperframes",
    "subdir": "skills",
    "hub": "docs-figures",
    "license": "Apache-2.0",
    "license_files": ["LICENSE"],
