# ═══════════════════ 放置位置（必读）═══════════════════
# 本文件是 TEMPLATE（无真实值），放在 ~/.agents/skills/env.example（canonical 根）。
#
# 真正的 .env（填好密钥）放在：  ~/.agents/skills/.env
#   - 就在 ~/.agents/ 下（env.example 旁边），不进 git（.gitignore 排除）
#   - 每行必须带 export（见下方规则 1/2）
#   - 不要放进任何宿主目录（~/.claude/.env 等），保持单点维护
#
# 新机器复制后：把 ~/.agents/skills/.env 一并带过去，密钥即生效。
#
# 加载链：
#   终端交互会话   ← ~/.bashrc 里 [ -f ~/.agents/skills/.env ] && . ~/.agents/skills/.env
#   Claude Code 等 ← 宿主 settings.json 的 env 块（见规则 2）
#
══════════════════════════════════════════════════════

# API keys used by this skill library — template, no real values
#
# Copy the lines you need into your shell environment file (e.g. ~/.shell_env),
# fill in the values, and source it from ~/.bashrc AND ~/.profile.
#
#   [ -f "$HOME/.shell_env" ] && . "$HOME/.shell_env"
#
# Two rules that are easy to get wrong:
#
#   1. Every line MUST carry `export`. Without it the value is a shell-local
#      variable and never reaches a Python subprocess — the scripts in this
#      library will behave as if the key were missing.
#   2. Claude Code's Bash tool runs a NON-interactive, NON-login shell seeded
#      from a shell snapshot that exports only PATH, so neither ~/.bashrc nor
#      ~/.profile is read. To make these keys visible there, add to
#      ~/.claude/settings.json:
#
#          "env": { "BASH_ENV": "/home/<user>/.shell_env" }
#
# Never commit the filled-in file. .gitignore already excludes .env / .shell_env.

# ── Literature & citations ────────────────────────────────────────────────
# literature-review, literature-search-openalex, paper-lookup
# Free, required since 2026-02-13 — keyless OpenAlex calls fail with 409/429.
# https://openalex.org/settings/api
export OPENALEX_API_KEY=

# biopython, citation-management, clinvar-database, database-lookup,
# dbsnp-database, indication-dossier, ncbi-sequence-fetch, pubmed-database
# Free; raises the E-utilities rate limit from 3 to 10 requests/second.
# https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
export NCBI_API_KEY=
# Contact address NCBI requires alongside E-utilities requests.
export NCBI_EMAIL=

# pyzotero — Zotero library access
# https://www.zotero.org/settings/keys
export ZOTERO_API_KEY=

# parallel-web, research-lookup — Parallel.ai web search
export PARALLEL_API_KEY=

# exa-search, pi-agent — Exa neural web search
# https://dashboard.exa.ai/api-keys
export EXA_API_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────
# Used by 21 skills for their LLM-powered steps (figure generation,
# hypothesis generation, clinical report drafting, schematics, …).
# https://openrouter.ai/keys
export OPENROUTER_API_KEY=

# ── Biological & chemical databases ───────────────────────────────────────
# database-lookup, openfda-database — openFDA
# https://open.fda.gov/apis/authentication/
export FDA_API_KEY=

# database-lookup — DisGeNET gene-disease associations
export DISGENET_API_KEY=
# database-lookup — BioGRID interaction database
export BIOGRID_API_KEY=
# database-lookup — Broad CLUE / Connectivity Map
export CLUE_API_KEY=
# database-lookup — OMIM
export OMIM_API_KEY=
# database-lookup — Addgene plasmid repository
export ADDGENE_API_KEY=
# database-lookup — PatentsView
export PATENTSVIEW_API_KEY=

# database-lookup, pymatgen — Materials Project
# https://next-gen.materialsproject.org/api
export MP_API_KEY=

# ── Models & compute services ─────────────────────────────────────────────
# esm — EvolutionaryScale ESM Forge
export ESM_API_KEY=
# alphagenome-single-variant-analysis, credentials — DeepMind AlphaGenome
export ALPHAGENOME_API_KEY=
# tamarind — Tamarind Bio hosted structural-biology models
export TAMARIND_API_KEY=
# rowan — Rowan computational chemistry
export ROWAN_API_KEY=
# cirq — IonQ quantum backend
export IONQ_API_KEY=

# ── Lab automation & ELN ──────────────────────────────────────────────────
# adaptyv — Adaptyv Bio protein foundry
export ADAPTYV_API_KEY=
# autoskill — Adaptyv Foundry
export FOUNDRY_API_KEY=
# benchling-integration — Benchling tenant API
export BENCHLING_API_KEY=

# ── Local tooling ─────────────────────────────────────────────────────────
# autoskill — screenpipe daemon (localhost:3030)
export SCREENPIPE_TOKEN=
